<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>User Detail – DateYourLove Admin</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/assets/css/admin.css" />
</head>
<body class="admin-body">
  <%- include('header') %>
  <div class="admin-wrapper">
    <%- include('sidebar') %>
    <main class="admin-content">

      <div class="page-header">
        <div>
          <a href="/admin/users" style="font-size:0.8rem;color:#6b7280;text-decoration:none;display:inline-flex;align-items:center;gap:0.3rem;margin-bottom:0.4rem;">← Back to Users</a>
          <h2>User Detail</h2>
          <p>Full profile and subscription history.</p>
        </div>
      </div>

      <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } else if (!user) { %>
        <div class="alert alert-danger">User not found.</div>
      <% } else { %>

        <div class="card-panel" style="margin-bottom:1rem;">
          <div style="display:flex;align-items:center;gap:1.25rem;margin-bottom:1.5rem;">
            <% if (user.photo_url) { %>
              <img src="<%= user.photo_url %>" style="width:72px;height:72px;border-radius:50%;object-fit:cover;border:3px solid #fecaca;" />
            <% } else { %>
              <div style="width:72px;height:72px;border-radius:50%;background:linear-gradient(135deg,#E8283F,#A80F22);display:grid;place-items:center;color:#fff;font-size:1.75rem;font-weight:700;flex-shrink:0;">
                <%= (user.first_name || '?')[0].toUpperCase() %>
              </div>
            <% } %>
            <div>
              <div style="font-size:1.2rem;font-weight:700;color:#111827;"><%= user.first_name || '—' %></div>
              <div style="font-size:0.875rem;color:#6b7280;"><%= user.mobile || '' %> <% if(user.email){ %> · <%= user.email %><% } %></div>
            </div>
          </div>

          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:1rem;">
            <% const fields = [
              ['ID', user.id],
              ['Gender', user.gender],
              ['Date of Birth', user.dob ? new Date(user.dob).toLocaleDateString('en-IN') : null],
              ['Pronouns', user.pronouns],
              ['Interested In', user.interested_in],
              ['Height (cm)', user.height_cm],
              ['Relationship Type', user.relationship_type],
              ['Religion', user.religion],
              ['Zodiac', user.zodiac],
              ['Education', user.education],
              ['Family Plan', user.family_plan],
              ['Job', user.job],
              ['Languages', user.languages],
              ['Smoking', user.lifestyle_smoking],
              ['Drinking', user.lifestyle_drinking],
              ['Workout', user.lifestyle_workout],
              ['Diet', user.diet],
              ['Distance Preferred', user.distance_preferred],
              ['OTP Verified', user.is_otp_verified ? '✅ Yes' : '❌ No'],
              ['Joined', new Date(user.created_at).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'})],
            ]; %>
            <% fields.forEach(([label, val]) => { %>
              <div class="detail-item">
                <label><%= label %></label>
                <span><%= val || '—' %></span>
              </div>
            <% }); %>
            <% if (user.about) { %>
              <div class="detail-item" style="grid-column:1/-1;">
                <label>About</label>
                <span><%= user.about %></span>
              </div>
            <% } %>
          </div>
        </div>

        <div class="card-panel table-card">
          <h3>Subscription History</h3>
          <% if (!subscriptions.length) { %>
            <p style="color:#9ca3af;font-size:0.875rem;">No subscriptions found.</p>
          <% } else { %>
          <table class="styled-table">
            <thead>
              <tr>
                <th>#</th>
                <th>Plan</th>
                <th>Duration</th>
                <th>Price Paid</th>
                <th>Status</th>
                <th>Start</th>
                <th>End</th>
              </tr>
            </thead>
            <tbody>
              <% subscriptions.forEach((sub) => {
                const sc = sub.status === 'active' ? 'status-active' : sub.status === 'expired' ? 'status-expired' : 'status-inactive';
              %>
                <tr>
                  <td style="color:#9ca3af;font-size:0.8rem;"><%= sub.id %></td>
                  <td style="font-weight:600;"><%= sub.plan_name || 'N/A' %></td>
                  <td><%= sub.duration_type || 'N/A' %></td>
                  <td>₹<%= sub.price_paid != null ? sub.price_paid : '—' %></td>
                  <td><span class="status-badge <%= sc %>"><%= sub.status %></span></td>
                  <td style="font-size:0.8rem;color:#6b7280;"><%= sub.start_date ? new Date(sub.start_date).toLocaleDateString('en-IN') : '—' %></td>
                  <td style="font-size:0.8rem;color:#6b7280;"><%= sub.end_date ? new Date(sub.end_date).toLocaleDateString('en-IN') : '—' %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
          <% } %>
        </div>

      <% } %>
    </main>
  </div>
</body>
</html>
