<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin User Detail – DateYourLove</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/assets/css/admin.css" />
</head>
<body class="admin-body">
  <%- include('header') %>
  <div class="admin-wrapper">
    <%- include('sidebar') %>
    <main class="admin-content">
      <div class="page-header">
        <div>
          <h2>User Detail</h2>
          <p>Full profile and subscription history for this user.</p>
        </div>
      </div>
      <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } else if (!user) { %>
        <div class="alert alert-danger">User not found.</div>
      <% } else { %>
        <div class="card-panel table-card">
          <table>
            <tbody>
              <tr><th>ID</th><td><%= user.id %></td></tr>
              <tr><th>Email</th><td><%= user.email %></td></tr>
              <tr><th>Mobile</th><td><%= user.mobile %></td></tr>
              <tr><th>Name</th><td><%= user.first_name %></td></tr>
              <tr><th>About</th><td><%= user.about || '—' %></td></tr>
              <tr><th>DOB</th><td><%= user.dob ? new Date(user.dob).toLocaleDateString() : '—' %></td></tr>
              <tr><th>Gender</th><td><%= user.gender || '—' %></td></tr>
              <tr><th>Pronouns</th><td><%= user.pronouns || '—' %></td></tr>
              <tr><th>Interested In</th><td><%= user.interested_in || '—' %></td></tr>
              <tr><th>Height (cm)</th><td><%= user.height_cm || '—' %></td></tr>
              <tr><th>Relationship Type</th><td><%= user.relationship_type || '—' %></td></tr>
              <tr><th>Open To</th><td><%= user.open_to || '—' %></td></tr>
              <tr><th>Religion</th><td><%= user.religion || '—' %></td></tr>
              <tr><th>Zodiac</th><td><%= user.zodiac || '—' %></td></tr>
              <tr><th>Education</th><td><%= user.education || '—' %></td></tr>
              <tr><th>Family Plan</th><td><%= user.family_plan || '—' %></td></tr>
              <tr><th>Communication Style</th><td><%= user.communication_style || '—' %></td></tr>
              <tr><th>Love Style</th><td><%= user.love_style || '—' %></td></tr>
              <tr><th>Pets</th><td><%= user.pets || '—' %></td></tr>
              <tr><th>Prompt</th><td><%= user.prompt || '—' %></td></tr>
              <tr><th>Job</th><td><%= user.job || '—' %></td></tr>
              <tr><th>Languages</th><td><%= user.languages || '—' %></td></tr>
              <tr><th>Smoking</th><td><%= user.lifestyle_smoking || '—' %></td></tr>
              <tr><th>Drinking</th><td><%= user.lifestyle_drinking || '—' %></td></tr>
              <tr><th>Workout</th><td><%= user.lifestyle_workout || '—' %></td></tr>
              <tr><th>Diet</th><td><%= user.diet || '—' %></td></tr>
              <tr><th>Lat/Lng</th><td><%= user.lat && user.lng ? `${user.lat}, ${user.lng}` : '—' %></td></tr>
              <tr><th>Distance Preferred</th><td><%= user.distance_preferred || '—' %></td></tr>
              <tr><th>OTP Verified</th><td><%= user.is_otp_verified ? 'Yes' : 'No' %></td></tr>
              <tr><th>Created</th><td><%= new Date(user.created_at).toLocaleString() %></td></tr>
              <tr><th>Updated</th><td><%= new Date(user.updated_at).toLocaleString() %></td></tr>
            </tbody>
          </table>
        </div>
        <div class="card-panel table-card">
          <h3>Subscription History</h3>
          <table>
            <thead>
              <tr>
                <th>ID</th>
                <th>Plan</th>
                <th>Duration</th>
                <th>Price Paid</th>
                <th>Status</th>
                <th>Start</th>
                <th>End</th>
              </tr>
            </thead>
            <tbody>
              <% subscriptions.forEach((sub) => { %>
                <tr>
                  <td><%= sub.id %></td>
                  <td><%= sub.plan_name || 'N/A' %></td>
                  <td><%= sub.duration_type || 'N/A' %></td>
                  <td><%= sub.price_paid != null ? sub.price_paid : 'N/A' %></td>
                  <td><%= sub.status %></td>
                  <td><%= sub.start_date ? new Date(sub.start_date).toLocaleDateString() : '—' %></td>
                  <td><%= sub.end_date ? new Date(sub.end_date).toLocaleDateString() : '—' %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </main>
  </div>
</body>
</html>
