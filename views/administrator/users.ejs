<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Users – DateYourLove</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/assets/css/admin.css" />
</head>
<body class="admin-body">
  <%- include('header') %>
  <div class="admin-wrapper">
    <%- include('sidebar') %>
    <main class="admin-content">
      <div class="page-header">
        <div>
          <h2>Users</h2>
          <p>Latest user registrations and contact details.</p>
        </div>
      </div>
      <div class="card-panel table-card">
        <h3>Recent Users</h3>
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>Email</th>
              <th>Mobile</th>
              <th>Name</th>
              <th>Current Plan</th>
              <th>Plan Status</th>
              <th>Joined</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach((user) => { %>
              <tr>
                <td><a href="/admin/users/<%= user.id %>"><%= user.id %></a></td>
                <td><%= user.email || 'N/A' %></td>
                <td><%= user.mobile || 'N/A' %></td>
                <td><%= user.first_name || '—' %></td>
                <td><%= user.current_plan_name || 'None' %></td>
                <td><%= user.current_plan_status || 'None' %></td>
                <td><%= new Date(user.created_at).toLocaleString() %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
        <% if (!users.length) { %>
          <p>No users found.</p>
        <% } else { %>
          <div class="pagination">
            <% if (page > 1) { %>
              <a href="/admin/users?page=<%= page - 1 %>" class="pagination-link">Previous</a>
            <% } %>
            <span class="pagination-info">Page <%= page %> of <%= totalPages %></span>
            <% if (page < totalPages) { %>
              <a href="/admin/users?page=<%= page + 1 %>" class="pagination-link">Next</a>
            <% } %>
          </div>
        <% } %>
      </div>
    </main>
  </div>
</body>
</html>
