<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Users – DateYourLove</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/assets/css/admin.css" />
  <style>
    .search-bar {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 1rem;
    }
    .search-bar input {
      flex: 1;
      padding: 0.65rem 1rem;
      border-radius: 10px;
      border: 1.5px solid #e5e7eb;
      font-size: 0.875rem;
      color: #111827;
      background: #f9fafb;
      outline: none;
      transition: border-color 0.2s;
    }
    .search-bar input:focus { border-color: #E8283F; background: #fff; }
    .search-bar button {
      padding: 0.65rem 1.2rem;
      border-radius: 10px;
      border: none;
      background: linear-gradient(135deg, #E8283F, #A80F22);
      color: #fff;
      font-size: 0.875rem;
      font-weight: 700;
      cursor: pointer;
    }
    .search-clear {
      padding: 0.65rem 1rem;
      border-radius: 10px;
      border: 1px solid #e5e7eb;
      background: #fff;
      color: #6b7280;
      font-size: 0.875rem;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
    }
    .search-clear:hover { background: #f3f4f6; }
    .search-result-info {
      font-size: 0.8rem;
      color: #6b7280;
      margin-bottom: 0.75rem;
    }
    .search-result-info strong { color: #E8283F; }
  </style>
</head>
<body class="admin-body">
  <%- include('header') %>
  <div class="admin-wrapper">
    <%- include('sidebar') %>
    <main class="admin-content">

      <div class="page-header">
        <div>
          <h2>Users</h2>
          <p>All registered users with plan and contact details.</p>
        </div>
        <span class="badge" style="font-size:0.85rem;padding:0.45rem 1rem;">Total: <%= totalUsers %></span>
      </div>

      <!-- Search Bar -->
      <form class="search-bar" method="GET" action="/admin/users">
        <input
          type="text"
          name="search"
          value="<%= search || '' %>"
          placeholder="🔍  Search by name, mobile or email..."
          autocomplete="off"
        />
        <button type="submit">Search</button>
        <% if (search) { %>
          <a href="/admin/users" class="search-clear">✕ Clear</a>
        <% } %>
      </form>

      <% if (search) { %>
        <div class="search-result-info">
          Showing <strong><%= totalUsers %></strong> result<%= totalUsers !== 1 ? 's' : '' %> for "<strong><%= search %></strong>"
        </div>
      <% } %>

      <div class="card-panel table-card">
        <% if (!users.length) { %>
          <p style="color:#6b7280;text-align:center;padding:2rem 0;">
            <%= search ? 'No users found for "' + search + '"' : 'No users found.' %>
          </p>
        <% } else { %>
        <table class="styled-table">
          <thead>
            <tr>
              <th>#</th>
              <th>User</th>
              <th>Mobile</th>
              <th>Email</th>
              <th>Plan</th>
              <th>Status</th>
              <th>Joined</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach((user, i) => {
              const serial = (page - 1) * 10 + i + 1;
              const initials = (user.first_name || '?')[0].toUpperCase();
              const statusClass = user.current_plan_status === 'active' ? 'status-active' : user.current_plan_status === 'expired' ? 'status-expired' : 'status-inactive';
            %>
              <tr class="user-row" data-uid="<%= user.id %>">
                <td style="color:#9ca3af;font-size:0.8rem;"><%= serial %></td>
                <td>
                  <div style="display:flex;align-items:center;gap:0.65rem;">
                    <% if (user.photo_url) { %>
                      <img src="<%= user.photo_url %>" alt="" style="width:34px;height:34px;border-radius:50%;object-fit:cover;border:2px solid #fecaca;" />
                    <% } else { %>
                      <div style="width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,#E8283F,#A80F22);display:grid;place-items:center;color:#fff;font-weight:700;font-size:0.85rem;flex-shrink:0;"><%= initials %></div>
                    <% } %>
                    <span style="font-weight:600;color:#111827;"><%= user.first_name || '—' %></span>
                  </div>
                </td>
                <td><%= user.mobile || '—' %></td>
                <td style="color:#6b7280;"><%= user.email || '—' %></td>
                <td><%= user.current_plan_name || 'Free' %></td>
                <td>
                  <% if (user.current_plan_status) { %>
                    <span class="status-badge <%= statusClass %>"><%= user.current_plan_status %></span>
                  <% } else { %>
                    <span style="color:#9ca3af;font-size:0.8rem;">—</span>
                  <% } %>
                </td>
                <td style="color:#6b7280;font-size:0.8rem;white-space:nowrap;"><%= new Date(user.created_at).toLocaleDateString('en-IN', {day:'2-digit',month:'short',year:'numeric'}) %></td>
                <td>
                  <button class="tbl-btn view-toggle" data-uid="<%= user.id %>"
                    data-photo="<%= user.photo_url || '' %>"
                    data-name="<%= user.first_name || '—' %>"
                    data-email="<%= user.email || '—' %>"
                    data-mobile="<%= user.mobile || '—' %>"
                    data-plan="<%= user.current_plan_name || 'Free' %>"
                    data-status="<%= user.current_plan_status || '—' %>"
                    data-joined="<%= new Date(user.created_at).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) %>"
                    data-gender="<%= user.gender || '—' %>"
                    data-dob="<%= user.dob ? new Date(user.dob).toLocaleDateString('en-IN') : '—' %>"
                    data-about="<%= (user.about || '—').replace(/\"/g,'&quot;') %>"
                    title="View details">👁️</button>
                </td>
              </tr>
              <tr class="detail-row" id="detail-<%= user.id %>" style="display:none;">
                <td colspan="8">
                  <div class="detail-row-inner">
                    <% if (user.photo_url) { %>
                      <img src="<%= user.photo_url %>" class="detail-avatar" alt="<%= user.first_name %>" />
                    <% } else { %>
                      <div class="detail-avatar-placeholder"><%= initials %></div>
                    <% } %>
                    <div class="detail-grid">
                      <div class="detail-item"><label>Full Name</label><span><%= user.first_name || '—' %></span></div>
                      <div class="detail-item"><label>Mobile</label><span><%= user.mobile || '—' %></span></div>
                      <div class="detail-item"><label>Email</label><span><%= user.email || '—' %></span></div>
                      <div class="detail-item"><label>Gender</label><span><%= user.gender || '—' %></span></div>
                      <div class="detail-item"><label>Date of Birth</label><span><%= user.dob ? new Date(user.dob).toLocaleDateString('en-IN') : '—' %></span></div>
                      <div class="detail-item"><label>Plan</label><span><%= user.current_plan_name || 'Free' %></span></div>
                      <div class="detail-item"><label>Plan Status</label><span><%= user.current_plan_status || '—' %></span></div>
                      <div class="detail-item"><label>OTP Verified</label><span><%= user.is_otp_verified ? '✅ Yes' : '❌ No' %></span></div>
                      <div class="detail-item"><label>Joined</label><span><%= new Date(user.created_at).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) %></span></div>
                      <div class="detail-item" style="grid-column:1/-1;"><label>About</label><span><%= user.about || '—' %></span></div>
                    </div>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>

        <div class="pagination">
          <% if (page > 1) { %>
            <a href="/admin/users?page=<%= page - 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %>" class="pagination-link">← Prev</a>
          <% } %>
          <span class="pagination-info">Page <%= page %> of <%= totalPages %></span>
          <% if (page < totalPages) { %>
            <a href="/admin/users?page=<%= page + 1 %><%= search ? '&search=' + encodeURIComponent(search) : '' %>" class="pagination-link">Next →</a>
          <% } %>
        </div>
        <% } %>
      </div>

    </main>
  </div>

  <script>
    document.querySelectorAll('.view-toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        const uid = btn.dataset.uid;
        const detailRow = document.getElementById('detail-' + uid);
        const isOpen = detailRow.style.display !== 'none';
        document.querySelectorAll('.detail-row').forEach(r => r.style.display = 'none');
        document.querySelectorAll('.tbl-btn.view-toggle').forEach(b => b.classList.remove('active-view'));
        if (!isOpen) {
          detailRow.style.display = 'table-row';
          btn.classList.add('active-view');
        }
      });
    });
  </script>
</body>
</html>
