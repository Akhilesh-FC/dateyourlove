<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Dashboard – DateYourLove</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/assets/css/admin.css" />
</head>
<body class="admin-body">
  <%- include('header') %>
  <div class="admin-wrapper">
    <%- include('sidebar') %>
    <main class="admin-content">
      <div class="stats-grid">
        <div class="stat-card stat-card-strong">
          <div class="stat-title">Total Users</div>
          <div class="stat-value"><%= stats.users %></div>
        </div>
        <div class="stat-card stat-card-soft">
          <div class="stat-title">Active Plans</div>
          <div class="stat-value"><%= stats.activePlans %></div>
        </div>
        <div class="stat-card stat-card-soft">
          <div class="stat-title">Inactive Plans</div>
          <div class="stat-value"><%= stats.inactivePlans %></div>
        </div>
        <div class="stat-card stat-card-soft">
          <div class="stat-title">Total Plans</div>
          <div class="stat-value"><%= stats.totalPlans %></div>
        </div>
        <div class="stat-card stat-card-soft">
          <div class="stat-title">Weekly Signups</div>
          <div class="stat-value"><%= chartData.reduce((sum, item) => sum + item.value, 0) %></div>
        </div>
        <div class="stat-card stat-card-soft">
          <div class="stat-title">Today's Signups</div>
          <div class="stat-value"><%= chartData.length ? chartData[chartData.length - 1].value : 0 %></div>
        </div>
        <div class="stat-card stat-card-soft">
          <div class="stat-title">Avg / Day</div>
          <div class="stat-value"><%= chartData.length ? Math.round(chartData.reduce((sum, item) => sum + item.value, 0) / chartData.length) : 0 %></div>
        </div>
        <div class="stat-card stat-card-soft">
          <div class="stat-title">Admin Sessions</div>
          <div class="stat-value">1</div>
        </div>
      </div>

      <div class="dashboard-cards">
        <div class="card-panel chart-card">
          <div class="card-panel-header">
            <h3>Weekly Signups</h3>
            <span class="badge">Live</span>
          </div>
          <canvas id="signupChart"></canvas>
        </div>

        <div class="card-panel quick-actions">
          <div class="card-panel-header">
            <h3>Quick Actions</h3>
          </div>
          <div class="action-grid">
            <div class="action-item">Manage users faster</div>
            <div class="action-item">View active plans</div>
            <div class="action-item">Change password securely</div>
            <div class="action-item">Logout when done</div>
          </div>
        </div>
      </div>
    </main>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script>
    const chartData = <%- JSON.stringify(chartData || []) %>;
    const labels = chartData.map(item => item.label);
    const values = chartData.map(item => item.value);
    const ctx = document.getElementById('signupChart');
    if (ctx) {
      new Chart(ctx, {
        type: 'line',
        data: {
          labels,
          datasets: [{
            label: 'New Users',
            data: values,
            borderColor: '#2563eb',
            backgroundColor: 'rgba(37, 99, 235, 0.18)',
            tension: 0.3,
            fill: true,
            pointRadius: 4,
          }],
        },
        options: {
          responsive: true,
          scales: {
            x: { grid: { display: false } },
            y: { beginAtZero: true, grid: { color: 'rgba(15, 23, 42, 0.08)' } },
          },
        },
      });
    }
  </script>
</body>
</html>
