<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Subscriptions – DateYourLove Admin</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/assets/css/admin.css" />
  <style>
    .validity-bar {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .validity-bar .vdate { font-size: 0.78rem; color: #374151; font-weight: 500; }
    .validity-bar .vlabel { font-size: 0.68rem; color: #9ca3af; }
    .txn-id { font-size: 0.72rem; color: #9ca3af; font-family: monospace; }
  </style>
</head>
<body class="admin-body">
  <%- include('header') %>
  <div class="admin-wrapper">
    <%- include('sidebar') %>
    <main class="admin-content">

      <div class="page-header">
        <div>
          <h2>Subscriptions</h2>
          <p>All user subscriptions with plan, validity and payment details.</p>
        </div>
        <span class="badge" style="font-size:0.85rem;padding:0.45rem 1rem;">Total: <%= subscriptions.length %></span>
      </div>

      <% if (message) { %><div class="alert alert-success">✅ <%= message %></div><% } %>
      <% if (error)   { %><div class="alert alert-danger">⚠️ <%= error %></div><% } %>

      <div class="card-panel table-card">
        <% if (!subscriptions.length) { %>
          <p style="color:#9ca3af;text-align:center;padding:2rem 0;">No subscriptions found.</p>
        <% } else { %>
        <table class="styled-table">
          <thead>
            <tr>
              <th>#</th>
              <th>User</th>
              <th>Plan</th>
              <th>Duration</th>
              <th>Price Paid</th>
              <th>Status</th>
              <th>Valid From → Till</th>
              <th>Txn ID</th>
            </tr>
          </thead>
          <tbody>
            <% subscriptions.forEach(sub => {
              const sc = sub.status === 'active' ? 'status-active' : sub.status === 'expired' ? 'status-expired' : 'status-inactive';
              const planName = sub.plan_name || sub.plan_name_master || 'N/A';
              const durLabel = sub.duration_type || sub.duration_label || 'N/A';
              const price    = sub.price_paid != null ? sub.price_paid : (sub.duration_price != null ? sub.duration_price : '—');
              const initials = (sub.user_name || '?')[0].toUpperCase();
            %>
              <tr>
                <td style="color:#9ca3af;font-size:0.8rem;"><%= sub.id %></td>
                <td>
                  <div style="display:flex;align-items:center;gap:0.55rem;">
                    <% if (sub.user_photo) { %>
                      <img src="<%= sub.user_photo %>" style="width:30px;height:30px;border-radius:50%;object-fit:cover;border:2px solid #fecaca;flex-shrink:0;" />
                    <% } else { %>
                      <div style="width:30px;height:30px;border-radius:50%;background:linear-gradient(135deg,#E8283F,#A80F22);display:grid;place-items:center;color:#fff;font-weight:700;font-size:0.75rem;flex-shrink:0;"><%= initials %></div>
                    <% } %>
                    <div>
                      <div style="font-weight:600;font-size:0.875rem;color:#111827;"><%= sub.user_name || '—' %></div>
                      <div style="font-size:0.72rem;color:#9ca3af;"><%= sub.user_mobile || '' %></div>
                    </div>
                  </div>
                </td>
                <td style="font-weight:600;color:#111827;"><%= planName %></td>
                <td>
                  <span style="display:inline-flex;padding:0.25rem 0.65rem;border-radius:99px;background:#fef2f2;color:#b91c1c;font-size:0.75rem;font-weight:700;text-transform:capitalize;">
                    <%= durLabel %>
                  </span>
                </td>
                <td style="font-weight:700;color:#111827;">₹<%= price %></td>
                <td><span class="status-badge <%= sc %>"><%= sub.status %></span></td>
                <td>
                  <div class="validity-bar">
                    <% if (sub.start_date) { %>
                      <span class="vdate"><%= new Date(sub.start_date).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) %></span>
                      <span class="vlabel">Start</span>
                    <% } %>
                    <% if (sub.end_date) { %>
                      <span class="vdate" style="color:<%= sub.status==='active'?'#16a34a':'#dc2626' %>;">
                        <%= new Date(sub.end_date).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) %>
                      </span>
                      <span class="vlabel">Expires</span>
                    <% } %>
                    <% if (!sub.start_date && !sub.end_date) { %><span style="color:#9ca3af;font-size:0.8rem;">—</span><% } %>
                  </div>
                </td>
                <td>
                  <% if (sub.paytm_txn_id) { %>
                    <span class="txn-id"><%= sub.paytm_txn_id %></span>
                  <% } else { %>
                    <span style="color:#d1d5db;font-size:0.8rem;">—</span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
        <% } %>
      </div>

    </main>
  </div>
</body>
</html>
