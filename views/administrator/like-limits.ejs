<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Like Limits – DateYourLove Admin</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/assets/css/admin.css" />
</head>
<body class="admin-body">
  <%- include('header') %>
  <div class="admin-wrapper">
    <%- include('sidebar') %>
    <main class="admin-content">

      <div class="page-header">
        <div>
          <h2>Like Limits</h2>
          <p>Daily like &amp; superlike limits per user segment.</p>
        </div>
      </div>

      <% if (message) { %><div class="alert alert-success">✅ <%= message %></div><% } %>
      <% if (error)   { %><div class="alert alert-danger">⚠️ <%= error %></div><% } %>

      <div class="card-panel table-card">
        <% if (!limits.length) { %>
          <p style="color:#9ca3af;text-align:center;padding:2rem 0;">No limits found.</p>
        <% } else { %>
        <table class="styled-table">
          <thead>
            <tr>
              <th>#</th>
              <th>Segment Type</th>
              <th>Daily Likes</th>
              <th>Daily Superlikes</th>
              <th>Last Updated</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% limits.forEach(limit => { %>
              <tr>
                <td style="color:#9ca3af;font-size:0.8rem;"><%= limit.id %></td>
                <td>
                  <span style="display:inline-flex;align-items:center;gap:0.4rem;padding:0.3rem 0.8rem;border-radius:99px;background:linear-gradient(135deg,#E8283F,#A80F22);color:#fff;font-size:0.78rem;font-weight:700;text-transform:capitalize;">
                    ❤️ <%= limit.type %>
                  </span>
                </td>
                <td style="font-weight:700;font-size:1rem;color:#111827;"><%= limit.max_daily_likes %></td>
                <td style="font-weight:700;font-size:1rem;color:#111827;"><%= limit.max_daily_superlikes %></td>
                <td style="font-size:0.78rem;color:#9ca3af;">
                  <%= limit.updated_at ? new Date(limit.updated_at).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) : '—' %>
                </td>
                <td>
                  <button class="tbl-btn edit-limit-btn"
                    data-id="<%= limit.id %>"
                    data-type="<%= limit.type %>"
                    data-likes="<%= limit.max_daily_likes %>"
                    data-superlikes="<%= limit.max_daily_superlikes %>"
                    title="Edit">✏️</button>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
        <% } %>
      </div>

    </main>
  </div>

  <!-- Edit Modal -->
  <div class="modal-overlay" id="editModal">
    <div class="modal-card">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.25rem;">
        <h3 style="margin:0;font-size:1.1rem;">Edit Limit — <span id="modalType" style="color:#E8283F;text-transform:capitalize;"></span></h3>
        <button id="modalClose" style="border:none;background:none;font-size:1.2rem;cursor:pointer;color:#9ca3af;line-height:1;">✕</button>
      </div>
      <form id="editForm" method="POST">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1.25rem;">
          <div>
            <label style="display:block;font-size:0.75rem;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;">Daily Likes</label>
            <input type="number" id="modalLikes" name="max_daily_likes" min="0"
              style="width:100%;padding:0.7rem 0.85rem;border-radius:10px;border:1.5px solid #e5e7eb;font-size:1rem;font-weight:700;color:#111827;background:#f9fafb;outline:none;box-sizing:border-box;" />
          </div>
          <div>
            <label style="display:block;font-size:0.75rem;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;">Daily Superlikes</label>
            <input type="number" id="modalSuperlikes" name="max_daily_superlikes" min="0"
              style="width:100%;padding:0.7rem 0.85rem;border-radius:10px;border:1.5px solid #e5e7eb;font-size:1rem;font-weight:700;color:#111827;background:#f9fafb;outline:none;box-sizing:border-box;" />
          </div>
        </div>
        <div style="display:flex;justify-content:flex-end;gap:0.6rem;">
          <button type="button" id="modalCancelBtn" class="btn-secondary">Cancel</button>
          <button type="submit" class="btn-primary">💾 Save</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    const modal    = document.getElementById('editModal');
    const form     = document.getElementById('editForm');
    const modalType = document.getElementById('modalType');
    const modalLikes = document.getElementById('modalLikes');
    const modalSuperlikes = document.getElementById('modalSuperlikes');

    function openModal(btn) {
      modalType.textContent      = btn.dataset.type;
      modalLikes.value           = btn.dataset.likes;
      modalSuperlikes.value      = btn.dataset.superlikes;
      form.action                = '/admin/like-limits/' + btn.dataset.id;
      modal.style.display        = 'flex';
      modalLikes.focus();
    }

    function closeModal() { modal.style.display = 'none'; }

    document.querySelectorAll('.edit-limit-btn').forEach(btn => {
      btn.addEventListener('click', () => openModal(btn));
    });

    document.getElementById('modalClose').addEventListener('click', closeModal);
    document.getElementById('modalCancelBtn').addEventListener('click', closeModal);
    modal.addEventListener('click', e => { if (e.target === modal) closeModal(); });
  </script>
</body>
</html>
