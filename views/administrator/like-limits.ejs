<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Like Limits – DateYourLove</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/assets/css/admin.css" />
</head>
<body class="admin-body">
  <%- include('header') %>
  <div class="admin-wrapper">
    <%- include('sidebar') %>
    <main class="admin-content">

      <div class="page-header">
        <div>
          <h2>Like Limits</h2>
          <p>Set daily like &amp; superlike limits per user segment.</p>
        </div>
      </div>

      <% if (message) { %><div class="alert alert-success">✅ <%= message %></div><% } %>
      <% if (error)   { %><div class="alert alert-danger">⚠️ <%= error %></div><% } %>

      <form method="POST" action="/admin/like-limits">
        <div class="limits-grid">
          <% limits.forEach((limit) => { %>
            <div class="limit-card">
              <input type="hidden" name="ids" value="<%= limit.id %>">
              <div class="limit-type-badge">❤️ <%= limit.type %></div>
              <div class="limit-fields">
                <div class="limit-field">
                  <label>Daily Likes</label>
                  <input type="number" name="max_daily_likes" value="<%= limit.max_daily_likes %>" min="0" />
                </div>
                <div class="limit-field">
                  <label>Superlikes</label>
                  <input type="number" name="max_daily_superlikes" value="<%= limit.max_daily_superlikes %>" min="0" />
                </div>
              </div>
            </div>
          <% }); %>
        </div>
        <div class="save-row">
          <button type="submit" class="btn-primary">💾 Save Changes</button>
        </div>
      </form>

    </main>
  </div>
</body>
</html>
